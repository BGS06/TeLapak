# =====================================================================
# TeLapak — Contoh Variabel Lingkungan (.env.local / Vercel Env Vars)
# =====================================================================

# 1. Supabase (Wajib)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"

# 2. URL Aplikasi Publik & Kampus Default
NEXT_PUBLIC_SITE_URL="https://telapak26.vercel.app"
NEXT_PUBLIC_DEFAULT_CAMPUS_SLUG="telu-surabaya"

# 3. Payment Gateway QRIS & E-Wallet (pilih: mock | midtrans | doku)
PAYMENT_PROVIDER="mock"

# 3a. Midtrans Snap (isi jika PAYMENT_PROVIDER=midtrans)
# Webhook URL: https://telapak26.vercel.app/api/payments/webhook/midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# 3b. DOKU Checkout / Jokul (isi jika PAYMENT_PROVIDER=doku)
# Webhook URL: https://telapak26.vercel.app/api/payments/webhook/doku
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
DOKU_IS_PRODUCTION="false"

# 4. Email Transaksional Resend (notifikasi bayar, H+2, sengketa, payout)
RESEND_API_KEY=""
EMAIL_FROM="TeLapak <notifikasi@telapak.id>"
ADMIN_NOTIFICATION_EMAIL="admin@telkomuniversity.ac.id"

# 5. Cron Secret (dipakai oleh cron-job.org / pg_cron untuk /api/cron/tick)
CRON_SECRET="<string-acak-panjang-minimal-32-karakter>"
